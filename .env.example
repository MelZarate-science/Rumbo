# Copiar este archivo a .env y completar con los valores reales.
# El .env real NUNCA se commitea (está en .gitignore).

# --- Google Cloud (Firestore + Cloud Run) ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1

# --- Gemini ---
# GEMINI_API_KEY: la que se obtiene gratis en https://aistudio.google.com/apikey
# (Google AI Studio, capa gratuita, NO consume crédito de GCP ni billing).
# Si se deja vacía, el cliente cae a Vertex AI usando GOOGLE_CLOUD_PROJECT
# (eso sí requiere billing habilitado en el proyecto).
GEMINI_API_KEY=
# La competencia exige Gemini 3.5 o superior. Ese modelo hoy solo esta
# disponible en el endpoint "global" de Vertex AI para este proyecto --
# "us-central1" todavia devuelve 404. Si en el futuro tu proyecto ya lo
# sirve en una region puntual, podes volver a fijarla ahi.
VERTEX_AI_LOCATION=global
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL_FLASH=gemini-3.5-flash
GEMINI_MODEL_PRO=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- Firestore ---
FIRESTORE_DATABASE_ID=(default)

# --- App ---
PORT=8080
UMBRAL_FIT_MINIMO=75

# --- Auth (backlog 1.1) ---
# Clave para firmar los tokens de sesión (HMAC). Generar una random real:
# python -c "import secrets; print(secrets.token_hex(32))"
AUTH_SECRET_KEY=

# --- MVP Local (opcional) ---
# Para desarrollo sin credenciales GCP, levanta el emulador de Firestore:
#   gcloud emulators firestore start --host-port=localhost:8080
# y exporta:
#   FIRESTORE_EMULATOR_HOST=localhost:8080
# (el SDK de Firestore lo detecta automáticamente)

# Nota: los 3 agentes (clasificador, extractor, auditor) y los embeddings
# llaman a Gemini de verdad. Con GEMINI_API_KEY seteada (Google AI Studio)
# alcanza con esa key — no hace falta GCP ni billing para esto. GOOGLE_CLOUD_PROJECT
# sigue haciendo falta para Firestore y, si se despliega, para Cloud Run.
