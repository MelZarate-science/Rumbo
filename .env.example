# Copiar este archivo a .env y completar con los valores reales.
# El .env real NUNCA se commitea (está en .gitignore).

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1

# --- Vertex AI (Gemini) ---
VERTEX_AI_LOCATION=us-central1
GEMINI_MODEL_FLASH=gemini-3.5-flash
GEMINI_MODEL_PRO=gemini-3.5-pro

# --- Firestore ---
FIRESTORE_DATABASE_ID=(default)

# --- Pub/Sub ---
PUBSUB_TOPIC_PERFIL_REGISTRADO=perfil-registrado
PUBSUB_SUBSCRIPTION_MATCHING=matching-worker

# --- App ---
PORT=8080
UMBRAL_FIT_MINIMO=75
